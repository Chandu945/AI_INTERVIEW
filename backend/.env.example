GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
FRONTEND_ORIGIN=http://localhost:3000
# Optional: how much Gemini "thinks" before answering. Less thinking = faster answers.
# Gemini 3 models take a level (minimal, low, medium, high); older models take a token
# budget instead (0 turns thinking off). Leave both unset to use the model's default.
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_THINKING_BUDGET=0
# Optional: when Gemini is slow to start answering (or fails), the request is also sent to
# this model, which runs on separate capacity, and the first reply is used. It answers with
# minimal thinking, so use a Gemini 3 model. If it refuses (say, a free-tier daily limit is
# used up), retries go to GEMINI_MODEL. Set it empty to always retry with GEMINI_MODEL.
# GEMINI_BACKUP_MODEL=gemini-3.1-flash-lite
# Optional backend-only access gate; bundled frontend does not support this header:
# INTERACT_ACCESS_TOKEN=
